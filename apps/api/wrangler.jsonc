{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoplist-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Served only on the workers.dev address. Per-version preview URLs are off so old builds are not reachable.
  "workers_dev": true,
  "preview_urls": false,

  // The React app is built into apps/web/dist and served by this Worker as static assets
  // (free and unmetered). Only /api/* runs Worker code.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // SUPER_ADMIN_GITHUB_ID is the numeric id of the one GitHub account that owns this site (public information).
  // SIGNIN_MODE is deliberately unset: the default is owner-only. Set it to "open" only to let anyone sign in.
  "vars": { "APP_ORIGIN": "http://localhost:8787", "SUPER_ADMIN_GITHUB_ID": "132331252" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoplist-control",
      "database_id": "da6bb237-8d72-4fe1-bc18-b974e22dbefc",
      "migrations_dir": "migrations/control"
    }
  ],

  "durable_objects": { "bindings": [{ "name": "INVENTORY", "class_name": "InventoryDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InventoryDO"] }],

  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 10 } }]
}
